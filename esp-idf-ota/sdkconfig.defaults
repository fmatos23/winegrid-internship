# Default sdkconfig parameters to use the OTA
# partition table layout, with a 4MB flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Bootloader-level rollback support. Without this, an update is applied
# unconditionally and permanently - same limitation we hit with Zephyr's
# MCUboot in upgrade-only mode. With it, a new image boots in a "pending
# verify" state; if it never confirms itself healthy (crash, hang, watchdog,
# power loss), the bootloader reverts to the last known-good image on the
# next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi credentials (PoC convenience, same trade-off as the Zephyr build -
# see notas_estagio.md). REDACTED for version control - fill in locally
# before building, or override in a local sdkconfig (not versioned).
CONFIG_EXAMPLE_WIFI_SSID="CHANGE_ME_SSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="CHANGE_ME_PASSWORD"
CONFIG_EXAMPLE_CONNECT_WIFI=y

# Update with your machine's LAN IP (see notas_estagio.md for how the server
# side is set up).
CONFIG_EXAMPLE_FIRMWARE_UPG_URL="http://CHANGE_ME_IP:8070/native_ota_example.bin"
