# Use ESP-IDF's built-in trusted CA bundle (same one used for HTTPS/OTA and
# for the ThingsBoard mqtts:// connection) to verify both the DPS global
# endpoint's and the assigned IoT Hub's TLS certificates.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# DPS provisioning credentials (Azure Portal -> watgrid-dps -> Overview for
# the ID Scope; -> Manage enrollments -> Individual Enrollments for the
# Registration ID and Primary Key).
# REDACTED for version control - fill in locally before building.
CONFIG_AZURE_DPS_ID_SCOPE="CHANGE_ME_ID_SCOPE"
CONFIG_AZURE_DPS_REGISTRATION_ID="esp32-winegrid"
CONFIG_AZURE_DPS_SYMMETRIC_KEY="CHANGE_ME_PRIMARY_KEY"

# Wi-Fi credentials (same trade-off as the other PoCs - see notas_estagio.md).
# REDACTED for version control - fill in locally before building.
CONFIG_EXAMPLE_WIFI_SSID="CHANGE_ME_SSID"
CONFIG_EXAMPLE_WIFI_PASSWORD="CHANGE_ME_PASSWORD"
CONFIG_EXAMPLE_CONNECT_WIFI=y

# OTA-capable partition table, same layout as esp-idf-ota/esp-idf-thingsboard.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# Bootloader-level rollback support, same as esp-idf-ota/esp-idf-thingsboard -
# a new image boots in a "pending verify" state; if it's never confirmed
# healthy the bootloader reverts to the last known-good image on the next
# reset. Takes effect on the next full flash (bootloader.bin is rewritten by
# a normal `idf.py flash`, no separate cable-only step needed here).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y