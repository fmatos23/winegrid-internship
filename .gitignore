esp-idf-mcp3221-poc/sdkconfig
mongoose-os-demo-c/build/
esp-rainmaker/
esp-rainmaker/build/

# Large third-party artifacts that can be regenerated (see notas_estagio.md
# for the exact clone/build commands used)
leshan-src/
leshan-server-demo.jar

# Logs from local test servers
*.log

# Python
__pycache__/
*.pyc

